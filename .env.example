# Application
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Session / auth
AUTH_SECRET=

# Database (Neon PostgreSQL)
DATABASE_URL=

# Cache / rate limit (Upstash Redis)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Media storage (Cloudinary)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Email (Resend adapter)
EMAIL_FROM=
RESEND_API_KEY=

# Payments. Set PAYMENT_APP_URL explicitly; it may be a sandbox tunnel and is
# deliberately independent from NODE_ENV. Leave credentials blank to hide a
# provider from checkout.
PAYMENT_APP_URL=http://localhost:3000
ARCA_TEST_MODE=true
ARCA_BASE_URL=
ARCA_USERNAME=
ARCA_PASSWORD=
ARCA_LIVE_BASE_URL=
ARCA_LIVE_USERNAME=
ARCA_LIVE_PASSWORD=
IDRAM_TEST_MODE=true
IDRAM_REC_ACCOUNT=
IDRAM_SECRET_KEY=
IDRAM_LIVE_REC_ACCOUNT=
IDRAM_LIVE_SECRET_KEY=

# Dev/test seed only (never commit real passwords)
